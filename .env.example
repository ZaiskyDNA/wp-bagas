# Salin ke .env lalu isi nilainya:  cp .env.example .env
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).

# Port lokal (8080 sering dipakai proyek lain)
WP_PORT=8088
WP_URL=http://localhost:8088

# Database lokal
DB_PASSWORD=ganti_password_db
DB_ROOT_PASSWORD=ganti_password_root

# Admin WordPress (hanya dipakai saat instalasi pertama)
WP_ADMIN_USER=admin_bagus
WP_ADMIN_PASSWORD=ganti_dengan_password_kuat
WP_ADMIN_EMAIL=admin@bagus-outdoor.id
